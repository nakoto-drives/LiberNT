#include <ntoskrnl.h>
#include <stdio.h>
#include <stdlib.h>
#include "eevdf_state.h"

#define PAGED_CODE() ((void)0)
#define CHECK(Condition) do { if (!(Condition)) { \
    fprintf(stderr, "line %d: %s\n", __LINE__, #Condition); exit(1); \
} } while (0)

typedef enum _PSPROCESSPRIORITYMODE
{
    PsProcessPriorityBackground,
    PsProcessPriorityForeground
} PSPROCESSPRIORITYMODE;

ULONG KiCyclesPerClockQuantum = 10;
KIRQL KeRaiseIrqlToSynchLevel(void) { return DISPATCH_LEVEL; }
void KeLowerIrql(KIRQL OldIrql) { CHECK(OldIrql == DISPATCH_LEVEL); }
void KeAcquireSpinLockAtDpcLevel(KSPIN_LOCK *Lock) { CHECK(*Lock == 0); *Lock = 1; }
void KeReleaseSpinLockFromDpcLevel(KSPIN_LOCK *Lock) { CHECK(*Lock == 1); *Lock = 0; }
void *ExAllocatePoolWithTag(int Pool, size_t Size, ULONG Tag)
{
    (void)Pool; (void)Tag; return malloc(Size);
}
void ExFreePoolWithTag(void *Pointer, ULONG Tag) { (void)Tag; free(Pointer); }
static KPRIORITY PspComputeQuantumAndPriority(PEPROCESS Process, PSPROCESSPRIORITYMODE Type, UCHAR *Quantum)
{
    *Quantum = 6;
    if (Process->PriorityClass != PROCESS_PRIORITY_CLASS_NORMAL) return 13;
    return Type == PsProcessPriorityForeground ? 9 : 8;
}
static void KeSetPriorityAndQuantumProcess(PKPROCESS Process, KPRIORITY Priority, UCHAR Quantum)
{
    CHECK(Quantum == 6);
    Process->BasePriority = Priority;
}

@FUNCTION@

int main(void)
{
    EPROCESS Process = {0};
    KTHREAD Thread = {0};
    PKI_EEVDF_THREAD_STATE State;
    KIRQL OldIrql;

    Process.PriorityClass = PROCESS_PRIORITY_CLASS_NORMAL;
    Process.Pcb.BasePriority = 8;
    Thread.Process = &Process.Pcb;
    Thread.Priority = 8;
    Thread.QuantumReset = 6;
    Thread.State = Ready;
    KiEevdfEnabled = TRUE;
    CHECK(KiEevdfCreateThreadState(&Thread));
    KiEevdfReadyThread(&Thread, TRUE);
    PsSetProcessPriorityByClass(&Process, PsProcessPriorityForeground);
    OldIrql = KiEevdfAcquireStateLock();
    State = KiEevdfFindThreadStateLocked(&Thread);
    CHECK(Process.Pcb.BasePriority == 9 && State->Foreground && State->Entity.Clock.Weight == 3072);
    KiEevdfReleaseStateLock(OldIrql);
    PsSetProcessPriorityByClass(&Process, PsProcessPriorityBackground);
    OldIrql = KiEevdfAcquireStateLock();
    CHECK(Process.Pcb.BasePriority == 8 && !State->Foreground && State->Entity.Clock.Weight == 1024);
    KiEevdfReleaseStateLock(OldIrql);
    Process.PriorityClass = 3;
    PsSetProcessPriorityByClass(&Process, PsProcessPriorityForeground);
    OldIrql = KiEevdfAcquireStateLock();
    CHECK(Process.Pcb.BasePriority == 13 && !State->Foreground && State->Entity.Clock.Weight == 1024);
    KiEevdfReleaseStateLock(OldIrql);
    KiEevdfDeleteThreadState(&Thread);
    return 0;
}
