 */

#include <ntoskrnl.h>
#include <stdio.h>
#include <stdlib.h>
#include "eevdf_state.h"

#define KI_THREAD_HANDOFF_USES_RUNNING 1
#define CHECK(Condition) do { if (!(Condition)) { \
    fprintf(stderr, "line %d: %s\n", __LINE__, #Condition); exit(1); \
} } while (0)

ULONG KiCyclesPerClockQuantum = 10;
static PKPRCB KiProcessorBlock[MAXIMUM_PROCESSORS];
KIRQL KeRaiseIrqlToSynchLevel(void) { return DISPATCH_LEVEL; }
void KeLowerIrql(KIRQL OldIrql) { CHECK(OldIrql == DISPATCH_LEVEL); }
void KeAcquireSpinLockAtDpcLevel(KSPIN_LOCK *Lock) { CHECK(*Lock == 0); *Lock = 1; }
void KeReleaseSpinLockFromDpcLevel(KSPIN_LOCK *Lock) { CHECK(*Lock == 1); *Lock = 0; }
void *ExAllocatePoolWithTag(int Pool, size_t Size, ULONG Tag)
{
    (void)Pool; (void)Tag; return malloc(Size);
}
void ExFreePoolWithTag(void *Pointer, ULONG Tag) { (void)Tag; free(Pointer); }
static KPRIORITY KiApplyPriorityFloor(PKTHREAD Thread, KPRIORITY Priority) { (void)Thread; return Priority; }
static PKPRCB KiAcquireReadyThreadPrcb(PKTHREAD Thread) { (void)Thread; CHECK(0); return NULL; }
static void KiAcquirePrcbLock(PKPRCB Prcb) { CHECK(!Prcb->PrcbLock); Prcb->PrcbLock = 1; }
static void KiReleasePrcbLock(PKPRCB Prcb) { CHECK(Prcb->PrcbLock); Prcb->PrcbLock = 0; }
static void KiAssertReadyQueue(PKPRCB Prcb, KPRIORITY Priority) { (void)Prcb; (void)Priority; }
static BOOLEAN RemoveEntryList(PLIST_ENTRY Entry) { (void)Entry; CHECK(0); return FALSE; }
static void KiInsertDeferredReadyList(PKTHREAD Thread) { (void)Thread; CHECK(0); }
static PKTHREAD KiSelectReadyThread(KPRIORITY Priority, PKPRCB Prcb) { (void)Priority; (void)Prcb; return NULL; }
static void KiQueueReadyThread(PKTHREAD Thread, PKPRCB Prcb) { (void)Thread; (void)Prcb; CHECK(0); }
static void KiRescheduleThread(BOOLEAN Ipi, ULONG Processor) { (void)Ipi; (void)Processor; CHECK(0); }

@FUNCTION@

int main(void)
{
    KPRCB Prcb = {0};
    KTHREAD Thread = {0};
    PKI_EEVDF_THREAD_STATE State;
    KIRQL OldIrql;

    KiProcessorBlock[0] = &Prcb;
    Prcb.NextThread = &Thread;
    Thread.State = Standby;
    Thread.Priority = 8;
    Thread.QuantumReset = 6;
    KiEevdfEnabled = TRUE;
    CHECK(KiEevdfCreateThreadState(&Thread));
    CHECK(KiEevdfPlaceThread(&Thread, 0, 8, 1024, 60));
    KiSetPriorityThread(&Thread, 9);
    OldIrql = KiEevdfAcquireStateLock();
    State = KiEevdfFindThreadStateLocked(&Thread);
    CHECK(Thread.Priority == 9 && State->Initialized && State->Priority == 9);
    CHECK(State->PriorityLagValid & PRIORITY_MASK(8));
    KiEevdfReleaseStateLock(OldIrql);
    KiSetPriorityThread(&Thread, LOW_REALTIME_PRIORITY);
    OldIrql = KiEevdfAcquireStateLock();
    CHECK(Thread.Priority == LOW_REALTIME_PRIORITY && State->Entity.Domain == NULL && !State->Initialized);
    CHECK(State->PriorityLagValid & PRIORITY_MASK(9));
    KiEevdfReleaseStateLock(OldIrql);
    KiSetPriorityThread(&Thread, 8);
    OldIrql = KiEevdfAcquireStateLock();
    CHECK(Thread.Priority == 8 && State->Initialized && State->Priority == 8);
    KiEevdfReleaseStateLock(OldIrql);
    CHECK(!Prcb.PrcbLock && Prcb.NextThread == &Thread);
    KiEevdfDeleteThreadState(&Thread);
    return 0;
}
